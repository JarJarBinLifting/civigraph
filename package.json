{
  "name": "civigraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explorer les relations documentées du pouvoir politique français.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4300",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 4300",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:import": "node scripts/import-wikidata.mjs",
    "data:import:attali": "node scripts/import-wikidata.mjs --attali"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "cytoscape": "3.34.2",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
