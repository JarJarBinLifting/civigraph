{
  "name": "civigraph",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Explorer les relations documentées du pouvoir politique français.",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 4300",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "start": "next start --hostname 127.0.0.1 --port 4300",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:import": "node scripts/import-wikidata.mjs",
    "data:import:attali": "node scripts/import-wikidata.mjs --attali",
    "data:discover": "node scripts/discover-institutions.mjs",
    "data:import:network": "node scripts/import-wikidata.mjs --network",
    "data:import:current": "node scripts/import-wikidata.mjs --current && node scripts/build-current-roster.mjs",
    "data:import:expansion": "node scripts/import-wikidata.mjs --expansion && node scripts/import-assembly.mjs --expansion && node scripts/build-expansion-roster.mjs",
    "data:audit:current": "tsx scripts/audit-current.ts",
    "data:import:assembly": "node scripts/import-assembly.mjs",
    "data:import:integrity": "node scripts/import-integrity-watch.mjs",
    "data:layout": "tsx scripts/generate-system-layout.ts"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "cytoscape": "3.34.2",
    "cytoscape-fcose": "2.2.0",
    "lucide-react": "1.41.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "1.63.0",
    "@types/cytoscape-fcose": "2.2.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "fflate": "0.8.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "^4.130.0"
  }
}
